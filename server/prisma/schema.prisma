// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// USER MANAGEMENT
// -------------------------

model user {
  id                        String    @id @default(cuid())
  name                      String
  username                  String    @unique
  email                     String    @unique
  password                  String
  isVerified                Boolean?  @default(false)
  isAdmin                   Boolean?  @default(false)
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  expire                    DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  phone                     String?

  // Relations
  forgotPasswordRequests    ForgotPasswordRequest[] @relation("UserForgotPasswordRequests")
  processedRequests         ForgotPasswordRequest[] @relation("ProcessedByAdmin")
  userTokens                UserTokens[]
  roles                     UserRole[]
  notificationHistories     NotificationHistory[]
  fcmDeliveryStatuses       FcmDeliveryStatus[]

  // Civil construction relations
  projectMembers            ProjectMember[]
  projectOwners             ProjectOwner[]
  contractor                Contractor?             @relation("ContractorUsers", fields: [contractorId], references: [id])
  contractorId              String?
  labourProfile             Labour?
  drawingsUploaded          Drawing[]               @relation("DrawingUploader")
  drawingAccesses           DrawingAccess[]
  createdDiaries            SiteDiary[]            @relation("DiaryCreator")
  approvedDiaries           SiteDiary[]            @relation("DiaryApprover")
  progressLogs              ProjectProgressLog[]
  createdTasks              Task[]                  @relation("TaskCreator")
  updatedTasks              Task[]                  @relation("TaskUpdater")
  taskProgressLogs          TaskProgressLog[]
  measurementBooksCreated   MeasurementBook[]       @relation("MeasurementCreator")
  measurementBooksApproved  MeasurementBook[]       @relation("MeasurementApprover")
  contractorBillsCreated    ContractorBill[]        @relation("BillCreator")
  contractorBillsApproved   ContractorBill[]        @relation("BillApprover")

  // QC/NCR relations
  qcIssuesCreated           QCIssue[]               @relation("QCCreator")
  qcIssuesVerified          QCIssue[]               @relation("QCVerifier")
  qcIssuesClosed            QCIssue[]               @relation("QCCloser")
  qcUpdates                 QCUpdate[]

  // Inventory relations
  materialTransfers         MaterialTransfer[]
  materialAdjustments       MaterialAdjustment[]

  // Procurement relations
  purchaseRequestsCreated   PurchaseRequest[]   @relation("PurchaseRequestCreator")
  purchaseRequestsApproved  PurchaseRequest[]   @relation("PurchaseRequestApprover")
  purchaseOrdersCreated     PurchaseOrder[]     @relation("POCreator")
  purchaseOrdersApproved    PurchaseOrder[]     @relation("POApprover")
  expensesPaid              Expense[]
  contractorAdvancesPaid    ContractorAdvance[]
  supplierPaymentsPaid      SupplierPayment[]
  estimates                 Estimate[]
}

enum ForgotPasswordStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ForgotPasswordRequest {
  id          String               @id @default(cuid())
  userId      String
  user        user                 @relation("UserForgotPasswordRequests", fields: [userId], references: [id])
  email       String
  status      ForgotPasswordStatus @default(PENDING)
  newPassword String?
  requestedAt DateTime             @default(now())
  processedAt DateTime?
  processedBy String?
  admin       user?                @relation("ProcessedByAdmin", fields: [processedBy], references: [id])
  reason      String?

  @@index([userId])
  @@index([status])
  @@index([processedBy])
}

// -------------------------
// ROLES & PERMISSIONS
// -------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles       UserRole[]
  projectMembers  ProjectMember[]
  drawingAccesses DrawingAccess[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

enum CivilUserRole {
  PROJECT_MANAGER
  SITE_ENGINEER
  CONTRACTOR
  LABOUR
  CLIENT
}

// -------------------------
// NOTIFICATIONS & FCM
// -------------------------

enum DeviceType {
  ANDROID
  IOS
  WEB
  MAC
  WINDOWS
  LINUX
  DESKTOP
  OTHER
}

model UserTokens {
  id         Int         @id @default(autoincrement())
  userId     String?
  token      String
  deviceType DeviceType?
  deviceId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lastUsed   DateTime    @default(now())

  user              user?               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_userId_fkey")
  FcmDeliveryStatus FcmDeliveryStatus[]

  @@unique([userId, deviceId])
}

enum NotificationTargetType {
  USER
  MULTIPLE_USERS
  ROLE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PARTIALLY_SENT
  READ
  DELIVERED
}

model NotificationHistory {
  id           Int                    @id @default(autoincrement())
  title        String
  body         String
  data         Json?
  targetType   NotificationTargetType
  targetIds    Json
  successCount Int                    @default(0)
  failureCount Int                    @default(0)
  status       NotificationStatus     @default(PENDING)
  sentAt       DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sentById     String?

  sentBy user?               @relation(fields: [sentById], references: [id], onDelete: SetNull)
  tokens FcmDeliveryStatus[]

  @@index([sentAt])
  @@index([targetType])
  @@index([sentById])
}

model FcmDeliveryStatus {
  id             Int                @id @default(autoincrement())
  notificationId Int
  tokenId        Int
  userId         String
  status         NotificationStatus @default(PENDING)
  errorMessage   String?
  errorCode      String?
  processedAt    DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  notification NotificationHistory @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  token        UserTokens          @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user         user                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([tokenId])
  @@index([userId])
  @@index([status])
}

// -------------------------
// PROJECT MANAGEMENT
// -------------------------

model Project {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  location  String?
  progress    Decimal       @db.Decimal(5,2) @default(0.0)
  area        String?
  nextMilestone String?
  milestoneDate DateTime?
  status    ProjectStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  progressLastUpdated DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members     ProjectMember[]
  owners      ProjectOwner[]
  contractors ProjectContractor[]
  drawings    Drawing[]
  models      ProjectModel[]
  materialDeliveries MaterialDelivery[]
  materialUsages     MaterialUsage[]
  siteDiaries        SiteDiary[]
  progressLogs       ProjectProgressLog[]
  tasks              Task[]
  boqItems           BOQItem[]
  rateContracts      RateContract[]
  measurementBooks   MeasurementBook[]
  contractorBills    ContractorBill[]
  qcIssues           QCIssue[]
  materialStock      MaterialStock[]
  stockLedger        MaterialStockLedger[]
  materialTransfers  MaterialTransfer[]
  materialAdjustments MaterialAdjustment[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  expenses           Expense[]
  contractorAdvances ContractorAdvance[]
  supplierPayments   SupplierPayment[]
  estimates          Estimate[]
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  roleId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

model ProjectOwner {
  id        String   @id @default(cuid())
  projectId String
  userId    String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectProgressLog {
  id        String   @id @default(cuid())
  projectId String
  progress  Decimal  @db.Decimal(5,2)
  milestone String?
  notes     String?
  loggedBy  String
  loggedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [loggedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([loggedBy])
}

// -------------------------
// TASK MANAGEMENT
// -------------------------

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskCategory {
  PRE_CONSTRUCTION
  FOUNDATION
  PLINTH
  STRUCTURE
  MASONRY
  PLASTERING
  ELECTRICAL
  PLUMBING
  FLOORING
  DOORS_WINDOWS
  PAINTING
  FINISHING
  EXTERNAL_WORK
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  title        String
  description  String?
  category     TaskCategory?
  status       TaskStatus   @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  weightage    Decimal      @db.Decimal(5,2) @default(0.0)

  // Assign contractor responsible
  contractorId String?

  // Track who created and updated
  createdBy    String
  updatedBy    String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  project      Project      @relation(fields: [projectId], references: [id])
  contractor   Contractor?  @relation(fields: [contractorId], references: [id])
  creator      user         @relation("TaskCreator", fields: [createdBy], references: [id])
  updater      user?        @relation("TaskUpdater", fields: [updatedBy], references: [id])

  progressLogs TaskProgressLog[]
  boqItems     BOQItem[]
  qcIssues     QCIssue[]
}

model TaskProgressLog {
  id         String    @id @default(cuid())
  taskId     String
  updatedBy  String
  progress   Decimal   @db.Decimal(5,2)
  notes      String?
  photos     Json?
  createdAt  DateTime  @default(now())

  task       Task      @relation(fields: [taskId], references: [id])
  user       user      @relation(fields: [updatedBy], references: [id])
}

// -------------------------
// CONTRACTORS
// -------------------------

model Contractor {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  type      ContractorType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Login accounts for contractor
  contractorUsers user[]              @relation("ContractorUsers")
  labours         Labour[]
  projects        ProjectContractor[]
  materialDeliveries MaterialDelivery[]
  materialUsages     MaterialUsage[]
  diaryLabourLogs   DiaryLabourLog[]
  tasks             Task[]
  rateContracts     RateContract[]
  measurementBooks  MeasurementBook[]
  contractorBills   ContractorBill[]
  qcIssues          QCIssue[]
  advances          ContractorAdvance[]
}

enum ContractorType {
  MAIN
  SUB
  LABOUR_SUPPLY
}

model ProjectContractor {
  id           String @id @default(cuid())
  projectId    String
  contractorId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractorId])
  @@index([projectId])
  @@index([contractorId])
}

// -------------------------
// LABOURS
// -------------------------

model Labour {
  id           String      @id @default(cuid())
  contractorId String
  userId       String?     @unique
  name         String
  gender       String?
  age          Int?
  skill        LabourSkill
  phone        String?
  aadhaar      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  user       user?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  materialUsages MaterialUsage[]
  diaryLabourLogs DiaryLabourLog[]

  @@index([contractorId])
  @@index([userId])
}

enum LabourSkill {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  MASON
  CARPENTER
  ELECTRICIAN
  PLUMBER
  OPERATOR
  HELPER
}

// -------------------------
// DRAWINGS & DOCUMENTS
// -------------------------

enum DrawingCategory {
  LAYOUT
  STRUCTURAL
  ARCHITECTURAL
  ELECTRICAL
  PLUMBING
  HVAC
  MODEL_3D
  PROGRESS
  OTHER
}

model Drawing {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  category    DrawingCategory @default(LAYOUT)
  description String?
  fileUrl     String
  fileType    DrawingType
  version     Int         @default(1)
  uploadedBy  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader       user            @relation("DrawingUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  accessControls DrawingAccess[]

  @@index([projectId])
  @@index([uploadedBy])
  @@index([fileType])
}

enum DrawingType {
  PDF
  IMAGE
  DWG
  DXF
  IFC
  RVT
  GLB
  MAP
  MP4
}

model DrawingAccess {
  id        String  @id @default(cuid())
  drawingId String
  roleId    String?
  userId    String?
  canView   Boolean @default(true)

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  user    user?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([drawingId])
  @@index([roleId])
  @@index([userId])
}

// -------------------------
// 3D MODELS / BIM / MAPS
// -------------------------

model ProjectModel {
  id        String    @id @default(cuid())
  projectId String
  type      ModelType
  fileUrl   String
  metadata  Json?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

enum ModelType {
  SITE_MAP
  CONTOUR_MAP
  CAD_3D
  BIM_3D
  STRUCTURAL_MODEL
  ARCHITECTURAL_MODEL
  MEP_MODEL
  WALKTHROUGH
}

// -------------------------
// MATERIAL MANAGEMENT
// -------------------------

enum QCStatus {
  PENDING
  APPROVED
  REJECTED
}

model Material {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String   // BAG, TON, CFT, KG, PCS etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries MaterialDelivery[]
  usages     MaterialUsage[]
  diaryMaterialLogs DiaryMaterialLog[]
  stock      MaterialStock[]
  stockLedger MaterialStockLedger[]
  transfers  MaterialTransfer[]
  adjustments MaterialAdjustment[]
  purchaseRequests PurchaseRequest[]
  poItems    POItem[]
}

model MaterialDelivery {
  id            String    @id @default(cuid())
  projectId     String
  materialId    String
  contractorId  String?
  supplierId    String?
  supplierName  String
  poId          String?
  quantity      Decimal
  unitPrice     Decimal?  // optional pricing
  totalPrice    Decimal?  // optional pricing
  deliveryDate  DateTime
  challanNumber String?
  notes         String?
  photos        Json?     // file URLs
  qcStatus      QCStatus  @default(PENDING)
  createdAt     DateTime  @default(now())

  project        Project         @relation(fields: [projectId], references: [id])
  material       Material        @relation(fields: [materialId], references: [id])
  contractor     Contractor?     @relation(fields: [contractorId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder?  @relation(fields: [poId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([contractorId])
  @@index([supplierId])
  @@index([poId])
}

model MaterialUsage {
  id            String    @id @default(cuid())
  projectId     String
  materialId    String
  contractorId  String?
  labourId      String?
  usageDate     DateTime
  quantityUsed  Decimal
  usedFor       String?   // e.g. "Footing", "Wall Casting", "Slab Work"
  notes         String?
  createdAt     DateTime  @default(now())

  project    Project     @relation(fields: [projectId], references: [id])
  material   Material    @relation(fields: [materialId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  labour     Labour?     @relation(fields: [labourId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([contractorId])
  @@index([labourId])
}

// -------------------------
// SITE DIARY
// -------------------------

enum DiaryStatus {
  PENDING
  APPROVED
  REJECTED
}

model SiteDiary {
  id          String     @id @default(cuid())
  projectId   String
  date        DateTime
  weather     String?
  location    String?   // optional: "Footing Area", "Block A Level 1"
  notes       String?
  issues      String?
  photos      Json?      // ["url1", "url2"]
  createdBy   String
  approvedBy  String?
  status      DiaryStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id])
  creator     user    @relation("DiaryCreator", fields: [createdBy], references: [id])
  approver    user?   @relation("DiaryApprover", fields: [approvedBy], references: [id])

  // relations
  labourLogs   DiaryLabourLog[]
  materialLogs DiaryMaterialLog[]
  equipmentLogs DiaryEquipmentLog[]
}

model DiaryLabourLog {
  id         String   @id @default(cuid())
  diaryId    String
  contractorId String?
  labourId   String?   // optional – log individual labour
  count      Int       // e.g. 8 labourers today
  workDone   String?
  createdAt  DateTime @default(now())

  diary       SiteDiary   @relation(fields: [diaryId], references: [id])
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  labour      Labour?     @relation(fields: [labourId], references: [id])
}

model DiaryMaterialLog {
  id            String   @id @default(cuid())
  diaryId       String
  materialId    String
  quantityUsed  Decimal
  notes         String?
  createdAt     DateTime @default(now())

  diary     SiteDiary @relation(fields: [diaryId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])
}

model DiaryEquipmentLog {
  id           String   @id @default(cuid())
  diaryId      String
  equipmentName String
  hoursUsed    Decimal
  operatorName String?
  notes        String?
  createdAt    DateTime @default(now())

  diary  SiteDiary @relation(fields: [diaryId], references: [id])
}

// -------------------------
// BILLING & CONTRACTOR PAYMENT
// -------------------------

enum BillStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  PAID
  REJECTED
}

model RateContract {
  id          String   @id @default(cuid())
  projectId   String
  contractorId String?
  boqItemId   String
  rate        Decimal  @db.Decimal(10,2)
  unit        String   // e.g. SQFT, CFT, KG, M3
  createdAt   DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  boqItem     BOQItem     @relation(fields: [boqItemId], references: [id])

  @@index([projectId])
  @@index([contractorId])
}

model BOQItem {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?     // Optional link to WBS item
  name        String
  unit        String
  estimatedQty Decimal?    // Planned quantity
  createdAt   DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?   @relation(fields: [taskId], references: [id])
  rateContracts RateContract[]
  measurements  MeasurementBook[]
  billItems     ContractorBillItem[]
}

model MeasurementBook {
  id          String   @id @default(cuid())
  boqItemId   String
  projectId   String
  contractorId String?
  measuredQty Decimal   @db.Decimal(10,3)
  description String?
  createdBy   String
  approvedBy  String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?

  boqItem   BOQItem     @relation(fields: [boqItemId], references: [id])
  project   Project     @relation(fields: [projectId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  creator   user        @relation("MeasurementCreator", fields: [createdBy], references: [id])
  approver  user?       @relation("MeasurementApprover", fields: [approvedBy], references: [id])
}

model ContractorBill {
  id            String   @id @default(cuid())
  projectId     String
  contractorId  String
  billNumber    String   @unique
  periodFrom    DateTime
  periodTo      DateTime
  totalAmount   Decimal  @db.Decimal(12,2) @default(0)
  status        BillStatus @default(DRAFT)
  createdBy     String
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contractor Contractor  @relation(fields: [contractorId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id])
  billItems  ContractorBillItem[]
  payments   ContractorPayment[]
  creator    user        @relation("BillCreator", fields: [createdBy], references: [id])
  approver   user?       @relation("BillApprover", fields: [approvedBy], references: [id])
}

model ContractorBillItem {
  id          String   @id @default(cuid())
  billId      String
  boqItemId   String
  measuredQty Decimal   @db.Decimal(10,3)
  rate        Decimal   @db.Decimal(10,2)
  amount      Decimal   @db.Decimal(12,2)
  createdAt   DateTime  @default(now())

  bill     ContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  boqItem  BOQItem        @relation(fields: [boqItemId], references: [id])
}

model ContractorPayment {
  id          String   @id @default(cuid())
  billId      String
  amountPaid  Decimal  @db.Decimal(12,2)
  paymentMode String?
  paymentDate DateTime @default(now())
  remarks     String?

  bill ContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

// -------------------------
// QUALITY CONTROL / NCR
// -------------------------

enum QCType {
  QUALITY
  SAFETY
  DEFECT        // Owner complaint / snag
  REWORK
}

enum NCRStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  REJECTED
}

enum QCPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model QCIssue {
  id            String      @id @default(cuid())
  projectId     String
  taskId        String?     // Optional link to WBS task
  type          QCType
  title         String
  description   String?
  priority      QCPriority  @default(MEDIUM)
  status        NCRStatus   @default(OPEN)

  // Who created this NCR (engineer, PM, or owner)
  createdBy     String
  assignedTo    String?     // contractorId
  verifiedBy    String?     // engineer who verified fix
  closedBy      String?     // PM who closed NCR

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  dueDate       DateTime?

  // Evidence
  photos        Json?       // Array of photo URLs
  location      String?     // e.g. "Slab 1", "Masonry Level 2"

  // Cost impact for billing integration
  costImpact    Decimal?    @db.Decimal(12,2)

  // Relations
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?       @relation(fields: [taskId], references: [id])
  creator       user        @relation("QCCreator", fields: [createdBy], references: [id])
  contractor    Contractor? @relation(fields: [assignedTo], references: [id])
  verifier      user?       @relation("QCVerifier", fields: [verifiedBy], references: [id])
  closer        user?       @relation("QCCloser", fields: [closedBy], references: [id])
  updates       QCUpdate[]

  @@index([projectId])
  @@index([taskId])
  @@index([assignedTo])
  @@index([status])
  @@index([type])
  @@index([priority])
}

model QCUpdate {
  id          String    @id @default(cuid())
  qcIssueId   String
  updatedBy   String
  status      NCRStatus
  notes       String?
  photos      Json?     // Array of photo URLs
  createdAt   DateTime  @default(now())

  qcIssue     QCIssue   @relation(fields: [qcIssueId], references: [id], onDelete: Cascade)
  user        user      @relation(fields: [updatedBy], references: [id])

  @@index([qcIssueId])
  @@index([updatedBy])
}

// -------------------------
// INVENTORY / STOCK MANAGEMENT
// -------------------------

enum StockEntryType {
  DELIVERY
  USAGE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum AdjustmentType {
  DAMAGE
  LOSS
  THEFT
  AUDIT
  CORRECTION
}

// Live stock balance per material per project
model MaterialStock {
  id          String   @id @default(cuid())
  projectId   String
  materialId  String
  openingQty  Decimal  @db.Decimal(12,3) @default(0)
  receivedQty Decimal  @db.Decimal(12,3) @default(0)
  usedQty     Decimal  @db.Decimal(12,3) @default(0)
  adjustedQty Decimal  @db.Decimal(12,3) @default(0)
  closingQty  Decimal  @db.Decimal(12,3) @default(0)
  location    String?  // warehouse, site, floor-1, etc.

  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([projectId, materialId])
  @@index([projectId])
  @@index([materialId])
}

// Complete audit trail of all stock movements
model MaterialStockLedger {
  id          String         @id @default(cuid())
  projectId   String
  materialId  String
  type        StockEntryType
  quantity    Decimal        @db.Decimal(12,3)
  notes       String?
  location    String?        // where material is stored
  relatedId   String?        // deliveryId, usageId, adjustmentId, transferId
  createdBy   String?        // user who made this entry
  createdAt   DateTime       @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([materialId])
  @@index([type])
  @@index([createdAt])
}

// Transfer materials between locations
model MaterialTransfer {
  id             String   @id @default(cuid())
  projectId      String
  materialId     String
  fromLocation   String?  // warehouse, site, floor-1, etc.
  toLocation     String?
  quantity       Decimal  @db.Decimal(12,3)
  notes          String?
  transferredBy  String
  createdAt      DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     user     @relation(fields: [transferredBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([materialId])
  @@index([transferredBy])
}

// Stock adjustments for damage, loss, audit corrections
model MaterialAdjustment {
  id            String         @id @default(cuid())
  projectId     String
  materialId    String
  type          AdjustmentType
  quantity      Decimal        @db.Decimal(12,3)  // positive or negative
  reason        String?
  photos        Json?          // evidence photos
  adjustedBy    String
  createdAt     DateTime       @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     user     @relation(fields: [adjustedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([materialId])
  @@index([type])
  @@index([adjustedBy])
}

// -------------------------
// PROCUREMENT / PURCHASE ORDERS
// -------------------------

// Supplier Master
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  panNumber   String?
  rating      Decimal? @db.Decimal(3,2) // 0.00 to 5.00
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  deliveries     MaterialDelivery[]
  payments       SupplierPayment[]

  @@index([name])
  @@index([isActive])
}

// Purchase Request / Material Indent
enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED_TO_PO
}

model PurchaseRequest {
  id           String                 @id @default(cuid())
  projectId    String
  requestedBy  String
  materialId   String
  quantity     Decimal                @db.Decimal(12,3)
  reason       String?
  urgency      String?                // LOW, MEDIUM, HIGH, URGENT
  status       PurchaseRequestStatus  @default(PENDING)
  createdAt    DateTime               @default(now())
  approvedBy   String?
  approvedAt   DateTime?
  rejectionReason String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material  Material @relation(fields: [materialId], references: [id])
  requester user     @relation("PurchaseRequestCreator", fields: [requestedBy], references: [id])
  approver  user?    @relation("PurchaseRequestApprover", fields: [approvedBy], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([requestedBy])
  @@index([status])
}

// Purchase Order Status
enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_SUPPLIER
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

// Purchase Order
model PurchaseOrder {
  id              String   @id @default(cuid())
  projectId       String
  supplierId      String
  poNumber        String   @unique
  totalAmount     Decimal  @db.Decimal(12,2) @default(0)
  taxAmount       Decimal? @db.Decimal(12,2)
  grandTotal      Decimal  @db.Decimal(12,2) @default(0)
  status          POStatus @default(DRAFT)
  deliveryAddress String?
  paymentTerms    String?
  notes           String?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  creator    user               @relation("POCreator", fields: [createdBy], references: [id])
  approver   user?              @relation("POApprover", fields: [approvedBy], references: [id])
  items            POItem[]
  deliveries       MaterialDelivery[]
  supplierPayments SupplierPayment[]

  @@index([projectId])
  @@index([supplierId])
  @@index([poNumber])
  @@index([status])
  @@index([createdBy])
}

// Purchase Order Items
model POItem {
  id           String  @id @default(cuid())
  poId         String
  materialId   String
  quantity     Decimal @db.Decimal(12,3)
  deliveredQty Decimal @db.Decimal(12,3) @default(0)
  pendingQty   Decimal @db.Decimal(12,3) @default(0)
  unitPrice    Decimal @db.Decimal(12,2)
  amount       Decimal @db.Decimal(12,2)
  taxPercent   Decimal? @db.Decimal(5,2)
  taxAmount    Decimal? @db.Decimal(12,2)
  totalAmount  Decimal @db.Decimal(12,2)
  notes        String?

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([poId])
  @@index([materialId])
}

// -------------------------
// FINANCE / EXPENSES MODULE
// -------------------------

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]
}

model Expense {
  id          String    @id @default(cuid())
  projectId   String
  categoryId  String
  amount      Decimal   @db.Decimal(12,2)
  description String?
  paymentDate DateTime  @default(now())
  paidById    String?
  paidTo      String?
  paymentMode PaymentMode
  receiptUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paidBy    user?           @relation(fields: [paidById], references: [id])

  @@index([projectId])
  @@index([categoryId])
  @@index([paidById])
  @@index([paymentDate])
}

model ContractorAdvance {
  id           String   @id @default(cuid())
  contractorId String
  projectId    String
  amount       Decimal  @db.Decimal(12,2)
  paidDate     DateTime @default(now())
  notes        String?
  paidById     String?

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paidBy     user?      @relation(fields: [paidById], references: [id])

  @@index([projectId])
  @@index([contractorId])
  @@index([paidById])
}

model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  projectId   String
  poId        String?
  amount      Decimal  @db.Decimal(12,2)
  paymentDate DateTime @default(now())
  notes       String?
  paidById    String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  po       PurchaseOrder? @relation(fields: [poId], references: [id])
  paidBy   user?    @relation(fields: [paidById], references: [id])

  @@index([projectId])
  @@index([supplierId])
  @@index([poId])
  @@index([paidById])
  @@index([paymentDate])
}

// -------------------------
// ESTIMATION MODULE
// -------------------------

enum ComponentType {
  MATERIAL
  LABOUR
  EQUIPMENT
  OVERHEAD
}

model Estimate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  totalCost   Decimal  @db.Decimal(12,2) @default(0)

  project   Project @relation(fields: [projectId], references: [id])
  creator   user    @relation(fields: [createdBy], references: [id])
  sections  EstimateSection[]
  items     EstimateItem[]
}

model EstimateSection {
  id         String   @id @default(cuid())
  estimateId String
  name       String
  order      Int       @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items    EstimateItem[]
}

model EstimateItem {
  id          String   @id @default(cuid())
  estimateId  String
  sectionId   String?
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12,3)
  rate        Decimal  @db.Decimal(12,2)
  amount      Decimal  @db.Decimal(12,2)

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section  EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  components EstimateRateComponent[]
}

model EstimateRateComponent {
  id          String   @id @default(cuid())
  itemId      String
  type        ComponentType
  name        String
  unit        String?
  quantity    Decimal? @db.Decimal(12,3)
  rate        Decimal? @db.Decimal(12,2)
  cost        Decimal? @db.Decimal(12,2)

  item EstimateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
