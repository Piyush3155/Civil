// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// USER MANAGEMENT
// -------------------------

model user {
  id                        String    @id @default(cuid())
  name                      String
  username                  String    @unique
  email                     String    @unique
  password                  String
  isVerified                Boolean?  @default(false)
  isAdmin                   Boolean?  @default(false)
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  expire                    DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  phone                     String?

  // Relations
  forgotPasswordRequests    ForgotPasswordRequest[] @relation("UserForgotPasswordRequests")
  processedRequests         ForgotPasswordRequest[] @relation("ProcessedByAdmin")
  userTokens                UserTokens[]
  roles                     UserRole[]
  notificationHistories     NotificationHistory[]
  fcmDeliveryStatuses       FcmDeliveryStatus[]

  // Civil construction relations
  projectMembers            ProjectMember[]
  projectOwners             ProjectOwner[]
  contractor                Contractor?             @relation("ContractorUsers", fields: [contractorId], references: [id])
  contractorId              String?
  labourProfile             Labour?
  drawingsUploaded          Drawing[]               @relation("DrawingUploader")
  drawingAccesses           DrawingAccess[]
  createdDiaries            SiteDiary[]            @relation("DiaryCreator")
  approvedDiaries           SiteDiary[]            @relation("DiaryApprover")
  progressLogs              ProjectProgressLog[]
  createdTasks              Task[]                  @relation("TaskCreator")
  updatedTasks              Task[]                  @relation("TaskUpdater")
  taskProgressLogs          TaskProgressLog[]
  measurementBooksCreated   MeasurementBook[]       @relation("MeasurementCreator")
  measurementBooksApproved  MeasurementBook[]       @relation("MeasurementApprover")
  contractorBillsCreated    ContractorBill[]        @relation("BillCreator")
  contractorBillsApproved   ContractorBill[]        @relation("BillApprover")
}

enum ForgotPasswordStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ForgotPasswordRequest {
  id          String               @id @default(cuid())
  userId      String
  user        user                 @relation("UserForgotPasswordRequests", fields: [userId], references: [id])
  email       String
  status      ForgotPasswordStatus @default(PENDING)
  newPassword String?
  requestedAt DateTime             @default(now())
  processedAt DateTime?
  processedBy String?
  admin       user?                @relation("ProcessedByAdmin", fields: [processedBy], references: [id])
  reason      String?

  @@index([userId])
  @@index([status])
  @@index([processedBy])
}

// -------------------------
// ROLES & PERMISSIONS
// -------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles       UserRole[]
  projectMembers  ProjectMember[]
  drawingAccesses DrawingAccess[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

enum CivilUserRole {
  PROJECT_MANAGER
  SITE_ENGINEER
  CONTRACTOR
  LABOUR
  CLIENT
}

// -------------------------
// NOTIFICATIONS & FCM
// -------------------------

enum DeviceType {
  ANDROID
  IOS
  WEB
  MAC
  WINDOWS
  LINUX
  DESKTOP
  OTHER
}

model UserTokens {
  id         Int         @id @default(autoincrement())
  userId     String?
  token      String
  deviceType DeviceType?
  deviceId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lastUsed   DateTime    @default(now())

  user              user?               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_userId_fkey")
  FcmDeliveryStatus FcmDeliveryStatus[]

  @@unique([userId, deviceId])
}

enum NotificationTargetType {
  USER
  MULTIPLE_USERS
  ROLE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PARTIALLY_SENT
  READ
  DELIVERED
}

model NotificationHistory {
  id           Int                    @id @default(autoincrement())
  title        String
  body         String
  data         Json?
  targetType   NotificationTargetType
  targetIds    Json
  successCount Int                    @default(0)
  failureCount Int                    @default(0)
  status       NotificationStatus     @default(PENDING)
  sentAt       DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sentById     String?

  sentBy user?               @relation(fields: [sentById], references: [id], onDelete: SetNull)
  tokens FcmDeliveryStatus[]

  @@index([sentAt])
  @@index([targetType])
  @@index([sentById])
}

model FcmDeliveryStatus {
  id             Int                @id @default(autoincrement())
  notificationId Int
  tokenId        Int
  userId         String
  status         NotificationStatus @default(PENDING)
  errorMessage   String?
  errorCode      String?
  processedAt    DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  notification NotificationHistory @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  token        UserTokens          @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user         user                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([tokenId])
  @@index([userId])
  @@index([status])
}

// -------------------------
// PROJECT MANAGEMENT
// -------------------------

model Project {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  location  String?
  progress    Decimal       @db.Decimal(5,2) @default(0.0)
  area        String?
  nextMilestone String?
  milestoneDate DateTime?
  status    ProjectStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  progressLastUpdated DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members     ProjectMember[]
  owners      ProjectOwner[]
  contractors ProjectContractor[]
  drawings    Drawing[]
  models      ProjectModel[]
  materialDeliveries MaterialDelivery[]
  materialUsages     MaterialUsage[]
  siteDiaries        SiteDiary[]
  progressLogs       ProjectProgressLog[]
  tasks              Task[]
  boqItems           BOQItem[]
  rateContracts      RateContract[]
  measurementBooks   MeasurementBook[]
  contractorBills    ContractorBill[]
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  roleId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

model ProjectOwner {
  id        String   @id @default(cuid())
  projectId String
  userId    String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectProgressLog {
  id        String   @id @default(cuid())
  projectId String
  progress  Decimal  @db.Decimal(5,2)
  milestone String?
  notes     String?
  loggedBy  String
  loggedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [loggedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([loggedBy])
}

// -------------------------
// TASK MANAGEMENT
// -------------------------

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskCategory {
  PRE_CONSTRUCTION
  FOUNDATION
  PLINTH
  STRUCTURE
  MASONRY
  PLASTERING
  ELECTRICAL
  PLUMBING
  FLOORING
  DOORS_WINDOWS
  PAINTING
  FINISHING
  EXTERNAL_WORK
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  title        String
  description  String?
  category     TaskCategory?
  status       TaskStatus   @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  weightage    Decimal      @db.Decimal(5,2) @default(0.0)

  // Assign contractor responsible
  contractorId String?

  // Track who created and updated
  createdBy    String
  updatedBy    String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  project      Project      @relation(fields: [projectId], references: [id])
  contractor   Contractor?  @relation(fields: [contractorId], references: [id])
  creator      user         @relation("TaskCreator", fields: [createdBy], references: [id])
  updater      user?        @relation("TaskUpdater", fields: [updatedBy], references: [id])

  progressLogs TaskProgressLog[]
  boqItems     BOQItem[]
}

model TaskProgressLog {
  id         String    @id @default(cuid())
  taskId     String
  updatedBy  String
  progress   Decimal   @db.Decimal(5,2)
  notes      String?
  photos     Json?
  createdAt  DateTime  @default(now())

  task       Task      @relation(fields: [taskId], references: [id])
  user       user      @relation(fields: [updatedBy], references: [id])
}

// -------------------------
// CONTRACTORS
// -------------------------

model Contractor {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  type      ContractorType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Login accounts for contractor
  contractorUsers user[]              @relation("ContractorUsers")
  labours         Labour[]
  projects        ProjectContractor[]
  materialDeliveries MaterialDelivery[]
  materialUsages     MaterialUsage[]
  diaryLabourLogs   DiaryLabourLog[]
  tasks             Task[]
  rateContracts     RateContract[]
  measurementBooks  MeasurementBook[]
  contractorBills   ContractorBill[]
}

enum ContractorType {
  MAIN
  SUB
  LABOUR_SUPPLY
}

model ProjectContractor {
  id           String @id @default(cuid())
  projectId    String
  contractorId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractorId])
  @@index([projectId])
  @@index([contractorId])
}

// -------------------------
// LABOURS
// -------------------------

model Labour {
  id           String      @id @default(cuid())
  contractorId String
  userId       String?     @unique
  name         String
  gender       String?
  age          Int?
  skill        LabourSkill
  phone        String?
  aadhaar      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  user       user?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  materialUsages MaterialUsage[]
  diaryLabourLogs DiaryLabourLog[]

  @@index([contractorId])
  @@index([userId])
}

enum LabourSkill {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  MASON
  CARPENTER
  ELECTRICIAN
  PLUMBER
  OPERATOR
  HELPER
}

// -------------------------
// DRAWINGS & DOCUMENTS
// -------------------------

enum DrawingCategory {
  LAYOUT
  STRUCTURAL
  ARCHITECTURAL
  ELECTRICAL
  PLUMBING
  HVAC
  MODEL_3D
  PROGRESS
  OTHER
}

model Drawing {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  category    DrawingCategory @default(LAYOUT)
  description String?
  fileUrl     String
  fileType    DrawingType
  version     Int         @default(1)
  uploadedBy  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader       user            @relation("DrawingUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  accessControls DrawingAccess[]

  @@index([projectId])
  @@index([uploadedBy])
  @@index([fileType])
}

enum DrawingType {
  PDF
  IMAGE
  DWG
  DXF
  IFC
  RVT
  GLB
  MAP
  MP4
}

model DrawingAccess {
  id        String  @id @default(cuid())
  drawingId String
  roleId    String?
  userId    String?
  canView   Boolean @default(true)

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  user    user?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([drawingId])
  @@index([roleId])
  @@index([userId])
}

// -------------------------
// 3D MODELS / BIM / MAPS
// -------------------------

model ProjectModel {
  id        String    @id @default(cuid())
  projectId String
  type      ModelType
  fileUrl   String
  metadata  Json?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

enum ModelType {
  SITE_MAP
  CONTOUR_MAP
  CAD_3D
  BIM_3D
  STRUCTURAL_MODEL
  ARCHITECTURAL_MODEL
  MEP_MODEL
  WALKTHROUGH
}

// -------------------------
// MATERIAL MANAGEMENT
// -------------------------

enum QCStatus {
  PENDING
  APPROVED
  REJECTED
}

model Material {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String   // BAG, TON, CFT, KG, PCS etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries MaterialDelivery[]
  usages     MaterialUsage[]
  diaryMaterialLogs DiaryMaterialLog[]
}

model MaterialDelivery {
  id            String    @id @default(cuid())
  projectId     String
  materialId    String
  contractorId  String?
  supplierName  String
  quantity      Decimal
  unitPrice     Decimal?  // optional pricing
  totalPrice    Decimal?  // optional pricing
  deliveryDate  DateTime
  challanNumber String?
  notes         String?
  photos        Json?     // file URLs
  qcStatus      QCStatus  @default(PENDING)
  createdAt     DateTime  @default(now())

  project    Project     @relation(fields: [projectId], references: [id])
  material   Material    @relation(fields: [materialId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([contractorId])
}

model MaterialUsage {
  id            String    @id @default(cuid())
  projectId     String
  materialId    String
  contractorId  String?
  labourId      String?
  usageDate     DateTime
  quantityUsed  Decimal
  usedFor       String?   // e.g. "Footing", "Wall Casting", "Slab Work"
  notes         String?
  createdAt     DateTime  @default(now())

  project    Project     @relation(fields: [projectId], references: [id])
  material   Material    @relation(fields: [materialId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  labour     Labour?     @relation(fields: [labourId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([contractorId])
  @@index([labourId])
}

// -------------------------
// SITE DIARY
// -------------------------

enum DiaryStatus {
  PENDING
  APPROVED
  REJECTED
}

model SiteDiary {
  id          String     @id @default(cuid())
  projectId   String
  date        DateTime
  weather     String?
  location    String?   // optional: "Footing Area", "Block A Level 1"
  notes       String?
  issues      String?
  photos      Json?      // ["url1", "url2"]
  createdBy   String
  approvedBy  String?
  status      DiaryStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id])
  creator     user    @relation("DiaryCreator", fields: [createdBy], references: [id])
  approver    user?   @relation("DiaryApprover", fields: [approvedBy], references: [id])

  // relations
  labourLogs   DiaryLabourLog[]
  materialLogs DiaryMaterialLog[]
  equipmentLogs DiaryEquipmentLog[]
}

model DiaryLabourLog {
  id         String   @id @default(cuid())
  diaryId    String
  contractorId String?
  labourId   String?   // optional – log individual labour
  count      Int       // e.g. 8 labourers today
  workDone   String?
  createdAt  DateTime @default(now())

  diary       SiteDiary   @relation(fields: [diaryId], references: [id])
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  labour      Labour?     @relation(fields: [labourId], references: [id])
}

model DiaryMaterialLog {
  id            String   @id @default(cuid())
  diaryId       String
  materialId    String
  quantityUsed  Decimal
  notes         String?
  createdAt     DateTime @default(now())

  diary     SiteDiary @relation(fields: [diaryId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])
}

model DiaryEquipmentLog {
  id           String   @id @default(cuid())
  diaryId      String
  equipmentName String
  hoursUsed    Decimal
  operatorName String?
  notes        String?
  createdAt    DateTime @default(now())

  diary  SiteDiary @relation(fields: [diaryId], references: [id])
}

// -------------------------
// BILLING & CONTRACTOR PAYMENT
// -------------------------

enum BillStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  PAID
  REJECTED
}

model RateContract {
  id          String   @id @default(cuid())
  projectId   String
  contractorId String?
  boqItemId   String
  rate        Decimal  @db.Decimal(10,2)
  unit        String   // e.g. SQFT, CFT, KG, M3
  createdAt   DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  boqItem     BOQItem     @relation(fields: [boqItemId], references: [id])

  @@index([projectId])
  @@index([contractorId])
}

model BOQItem {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?     // Optional link to WBS item
  name        String
  unit        String
  estimatedQty Decimal?    // Planned quantity
  createdAt   DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?   @relation(fields: [taskId], references: [id])
  rateContracts RateContract[]
  measurements  MeasurementBook[]
  billItems     ContractorBillItem[]
}

model MeasurementBook {
  id          String   @id @default(cuid())
  boqItemId   String
  projectId   String
  contractorId String?
  measuredQty Decimal   @db.Decimal(10,3)
  description String?
  createdBy   String
  approvedBy  String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?

  boqItem   BOQItem     @relation(fields: [boqItemId], references: [id])
  project   Project     @relation(fields: [projectId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  creator   user        @relation("MeasurementCreator", fields: [createdBy], references: [id])
  approver  user?       @relation("MeasurementApprover", fields: [approvedBy], references: [id])
}

model ContractorBill {
  id            String   @id @default(cuid())
  projectId     String
  contractorId  String
  billNumber    String   @unique
  periodFrom    DateTime
  periodTo      DateTime
  totalAmount   Decimal  @db.Decimal(12,2) @default(0)
  status        BillStatus @default(DRAFT)
  createdBy     String
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contractor Contractor  @relation(fields: [contractorId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id])
  billItems  ContractorBillItem[]
  payments   ContractorPayment[]
  creator    user        @relation("BillCreator", fields: [createdBy], references: [id])
  approver   user?       @relation("BillApprover", fields: [approvedBy], references: [id])
}

model ContractorBillItem {
  id          String   @id @default(cuid())
  billId      String
  boqItemId   String
  measuredQty Decimal   @db.Decimal(10,3)
  rate        Decimal   @db.Decimal(10,2)
  amount      Decimal   @db.Decimal(12,2)
  createdAt   DateTime  @default(now())

  bill     ContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  boqItem  BOQItem        @relation(fields: [boqItemId], references: [id])
}

model ContractorPayment {
  id          String   @id @default(cuid())
  billId      String
  amountPaid  Decimal  @db.Decimal(12,2)
  paymentMode String?
  paymentDate DateTime @default(now())
  remarks     String?

  bill ContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
}
